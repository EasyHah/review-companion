diff --git a/app/api/agent/[id]/review-companion/route.ts b/app/api/agent/[id]/review-companion/route.ts
new file mode 100644
index 0000000..5e36b10
--- /dev/null
+++ b/app/api/agent/[id]/review-companion/route.ts
@@ -0,0 +1,30 @@
+import { NextResponse } from "next/server";
+import { getRpcSession } from "@/lib/rpc-manager";
+import { reviewPanelUrl } from "@/lib/review-companion";
+
+type Registry = { peek(context: unknown): {
+  browserUrl: string;
+  session?: string;
+  connection?: { embedOrigin?: string };
+} | undefined };
+
+// Read a live extension's connection only. Never start a model or create a review.
+export async function GET(req: Request, { params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  const reply = (data: unknown, status = 200) => NextResponse.json(data, {
+    status, headers: { "Cache-Control": "private, no-store", "Referrer-Policy": "no-referrer" },
+  });
+  const session = getRpcSession(id);
+  if (!session?.isAlive()) return reply({ code: "inactive" }, 404);
+  const registry = Reflect.get(globalThis, Symbol.for("review-companion-pi.bridges.v2")) as Registry | undefined;
+  if (!registry) return reply({ code: "not_installed" }, 404);
+  try {
+    const bridge = registry.peek({ mode: "rpc", cwd: session.cwd, sessionManager: session.inner.sessionManager });
+    if (!bridge?.connection || !bridge.session) return reply({ code: "inactive" }, 409);
+    const data = { sessionId: id, url: bridge.browserUrl, embedOrigin: bridge.connection.embedOrigin };
+    // Next may use localhost internally; proxy.ts already verifies the browser's Host.
+    const origin = new URL(req.url).protocol + "//" + req.headers.get("host");
+    if (!reviewPanelUrl(data, id, origin)) return reply({ code: "origin_mismatch" }, 409);
+    return reply(data);
+  } catch { return reply({ code: "inactive" }, 409); }
+}
diff --git a/components/ReviewCompanionPanel.tsx b/components/ReviewCompanionPanel.tsx
new file mode 100644
index 0000000..16882de
--- /dev/null
+++ b/components/ReviewCompanionPanel.tsx
@@ -0,0 +1,46 @@
+"use client";
+import { useEffect, useState } from "react";
+import { useI18n } from "@/hooks/useI18n";
+import { reviewPanelUrl } from "@/lib/review-companion";
+
+export function ReviewCompanionPanel({ sessionId }: { sessionId: string | null }) {
+  const { t } = useI18n();
+  const [view, setView] = useState<{ url?: string; code: string }>({ code: "loading" });
+  const [revision, setRevision] = useState(0);
+  useEffect(() => {
+    if (!sessionId) return;
+    let cancelled = false;
+    let timer: ReturnType<typeof setTimeout>;
+    let controller: AbortController | undefined;
+    const update = async () => {
+      controller = new AbortController();
+      const deadline = setTimeout(() => controller?.abort(), 12000);
+      try {
+        const response = await fetch(`/api/agent/${encodeURIComponent(sessionId)}/review-companion`, {
+          cache: "no-store", signal: controller.signal,
+        });
+        const data = await response.json();
+        const url = response.ok ? reviewPanelUrl(data, sessionId, window.location.origin) : null;
+        if (!cancelled) setView(url ? { url, code: "ready" } : { code: data.code || "request_failed" });
+      } catch { if (!cancelled) setView({ code: "request_failed" }); }
+      finally {
+        clearTimeout(deadline);
+        if (!cancelled) timer = setTimeout(update, 5000);
+      }
+    };
+    void update();
+    return () => { cancelled = true; clearTimeout(timer); controller?.abort(); };
+  }, [sessionId, revision]);
+  const code = !sessionId ? "no_session" : view.code;
+  const known = ["loading", "no_session", "inactive", "not_installed", "origin_mismatch"];
+  return <section aria-label={t("review.title")} style={{ height: "100%", display: "flex", flexDirection: "column", minHeight: 0 }}>
+    {view.url && sessionId ? <iframe
+      title={t("review.title")} src={view.url} referrerPolicy="no-referrer"
+      sandbox="allow-scripts allow-same-origin allow-downloads" allow="clipboard-write"
+      style={{ width: "100%", flex: 1, minHeight: 0, border: 0, background: "var(--bg)" }}
+    /> : <div role="status" style={{ padding: 20, color: "var(--text-muted)", fontSize: 13, lineHeight: 1.7 }}>
+      <p>{t(`review.${known.includes(code) ? code : "request_failed"}`)}</p>
+      <button type="button" onClick={() => setRevision(v => v + 1)}>{t("review.retry")}</button>
+    </div>}
+  </section>;
+}
