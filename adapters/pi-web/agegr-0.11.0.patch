@@ -0,0 +1,17 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { reviewPanelUrl } from './review-companion.ts';
+
+const origin = 'http://127.0.0.1:30141';
+const data = { sessionId:'one', embedOrigin:origin, url:'http://127.0.0.1:32123/#token=abcdefghijklmnopqrstuvwxyz' };
+test('embedded review accepts only the selected session and exact parent origin', () => {
+  assert.equal(reviewPanelUrl(data,'one',origin), data.url);
+  assert.equal(reviewPanelUrl(data,'two',origin), null);
+  assert.equal(reviewPanelUrl(data,'one','http://127.0.0.1:9999'), null);
+  assert.equal(reviewPanelUrl({...data,embedOrigin:undefined},'one',origin), null);
+});
+test('review panel refuses remote URLs, paths, query tokens and credentials', () => {
+  for (const url of ['https://example.com/#token=abcdefghijklmnopqrstuvwxyz','http://127.0.0.1:32123/evil#token=abcdefghijklmnopqrstuvwxyz','http://user:pass@127.0.0.1:32123/#token=abcdefghijklmnopqrstuvwxyz','http://127.0.0.1:32123/?token=abcdefghijklmnopqrstuvwxyz','javascript:alert(1)']) {
+    assert.equal(reviewPanelUrl({...data,url},'one',origin), null);
+  }
+});
