{
  "name": "review-companion",
  "version": "0.4.0",
  "private": true,
  "description": "Shared review companion for Pi, Claude Code and Codex",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "review-pi": "./bin/review-pi.mjs"
  },
  "pi": {
    "extensions": [
      "./adapters/pi/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EasyHah/review-companion.git"
  },
  "homepage": "https://github.com/EasyHah/review-companion"
}
